<% in_progress = conversation.in_progress? %>
<%# is-locked keeps the in-progress conversation pinned to the top of the queue %>
<div class="card mb-4 <%= "has-background-primary-light is-locked" if in_progress %>"
     id="<%= dom_id(conversation) %>"
     data-conversation-id="<%= conversation.id %>"
     data-controller="conversation-expand">
  <header class="card-header <%= in_progress ? "has-background-primary" : "conversation-drag-header" %>"
          <%= tag.attributes(data: { queue_sort_handle: true }, title: "Drag to reorder") unless in_progress %>>
    <% unless in_progress %>
      <span class="card-header-icon conversation-handle" aria-hidden="true">⠿</span>
    <% end %>
    <p class="card-header-title <%= "has-text-white" if in_progress %>">
      <%= conversation.name %>
    </p>
    <% if in_progress %>
      <span class="card-header-icon">
        <span class="tag is-primary is-light">In progress</span>
      </span>
    <% end %>
  </header>

  <div class="card-content conversation-content"
       data-conversation-expand-target="content"
       data-action="click->conversation-expand#toggle">
    <% if conversation.answers.any? %>
      <% conversation.answers.each do |answer| %>
        <div class="mb-3">
          <p class="has-text-weight-semibold is-size-7"><%= answer.question_text %></p>
          <p><%= answer.value.presence || content_tag(:span, "—", class: "has-text-grey-light") %></p>
        </div>
      <% end %>
    <% else %>
      <p class="has-text-grey">No answers recorded.</p>
    <% end %>
  </div>

  <footer class="card-footer">
    <% if in_progress %>
      <%= button_to "Finish", finish_conversation_path(conversation), method: :patch,
                    class: "card-footer-item button is-ghost has-text-weight-semibold" %>
    <% else %>
      <%= button_to "Start", start_conversation_path(conversation), method: :patch,
                    class: "card-footer-item button is-ghost has-text-weight-semibold",
                    disabled: queue_in_progress %>
      <%= button_to "Delete", remove_conversation_path(conversation), method: :patch,
                    class: "card-footer-item button is-ghost has-text-danger",
                    form: { onsubmit: "return confirm('Delete this conversation?');" } %>
    <% end %>
  </footer>
</div>
