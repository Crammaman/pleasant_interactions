<% content_for :title, "#{@profile.display_name} — Queue" %>

<%# Live updates: anything that changes this queue broadcasts a page refresh
    (see Interaction#broadcasts_refreshes_to and QueuesController#reorder), and
    morphing applies it in place, so open cards, scroll position and an active
    drag survive someone else's change. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @queue %>

<div class="level">
  <div class="level-left">
    <div class="level-item">
      <div>
        <h1 class="title"><%= @profile.display_name %> — Queue</h1>
        <% if @queue.date %>
          <p class="subtitle is-6 has-text-grey"><%= @queue.date.to_fs(:long) %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="level-right">
    <div class="level-item">
      <%= link_to "Add Interaction", new_queue_interaction_path(@queue), class: "button is-primary" %>
    </div>
  </div>
</div>

<% if @interactions.any? %>
  <div id="queue-interactions"
       data-controller="queue-sort" data-queue-sort-url-value="<%= reorder_queue_path(@queue) %>">
    <%= render partial: "queues/interaction", collection: @interactions, as: :interaction,
               locals: { queue_in_progress: @in_progress.present? } %>
  </div>
<% else %>
  <div class="notification is-info is-light">
    <p>No interactions in this queue yet.</p>
    <%= link_to "Add an interaction", new_queue_interaction_path(@queue), class: "button is-primary mt-3" %>
  </div>
<% end %>
