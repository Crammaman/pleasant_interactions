<% content_for :title, "Add User" %>

<div class="columns is-centered">
  <div class="column is-8">
    <div class="box">
      <h1 class="title">Add User</h1>

      <%= form_with url: users_path, method: :post do |f| %>
        <%= fields_for :user, @user do |uf| %>
          <div class="field">
            <label class="label">Username</label>
            <div class="control">
              <%= uf.text_field :username, class: "input", autofocus: true, autocomplete: "username" %>
            </div>
          </div>

          <div class="field">
            <label class="label">Name</label>
            <div class="control">
              <%= uf.text_field :name, class: "input" %>
            </div>
          </div>

          <div class="field">
            <label class="label">Password</label>
            <div class="control">
              <%= uf.password_field :password, class: "input", autocomplete: "new-password" %>
            </div>
          </div>

          <div class="field">
            <label class="label">Password confirmation</label>
            <div class="control">
              <%= uf.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
            </div>
          </div>
        <% end %>

        <%= render "users/questions", converser: true, copy_from: @profiles, questions: @questions || [] %>

        <div class="field">
          <div class="control">
            <%= submit_tag "Create User", class: "button is-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
