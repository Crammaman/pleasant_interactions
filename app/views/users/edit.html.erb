<% content_for :title, "Edit User" %>

<div class="columns is-centered">
  <div class="column is-8">
    <div class="box">
      <h1 class="title">Edit User</h1>

      <%= form_with model: @user, url: user_path(@user), method: :patch do |f| %>
        <div class="field">
          <label class="label">Username</label>
          <div class="control">
            <%= f.text_field :username, class: "input", autofocus: true, autocomplete: "username" %>
          </div>
        </div>

        <div class="field">
          <label class="label">Name</label>
          <div class="control">
            <%= f.text_field :name, class: "input" %>
          </div>
        </div>

        <div class="field">
          <label class="label">Password</label>
          <div class="control">
            <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
          </div>
          <p class="help">Leave blank to keep the current password.</p>
        </div>

        <div class="field">
          <label class="label">Password confirmation</label>
          <div class="control">
            <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
          </div>
        </div>

        <%# A user without a profile isn't a converser yet, so offer the toggle
            rather than a question list with nothing to attach to. %>
        <% if @profile %>
          <%= render "users/questions", questions: @questions || @profile.questions %>
        <% else %>
          <%= render "users/questions", converser: true, copy_from: @profiles, questions: @questions || [] %>
        <% end %>

        <div class="field is-grouped">
          <div class="control">
            <%= f.submit "Save User", class: "button is-primary" %>
          </div>
          <div class="control">
            <%= link_to "Cancel", root_path, class: "button is-light" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
