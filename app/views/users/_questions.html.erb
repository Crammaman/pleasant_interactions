<%# The question builder, shared by the new and edit user forms.
    converser: pass true to render the checkbox that turns a user without a
    profile into a converser; an existing profile always shows its questions.
    copy_from: profiles whose questions can seed a blank form. %>
<% converser = local_assigns.fetch(:converser, false) %>
<% copy_from = local_assigns.fetch(:copy_from, []) %>
<% questions = local_assigns.fetch(:questions, []) %>
<% copy_from_data = copy_from.each_with_object({}) do |profile, memo|
     memo[profile.id] = profile.questions.map do |q|
       { text: q.text, question_type: q.question_type, options: q.options }
     end
   end %>

<div data-controller="questions" data-questions-profiles-value="<%= copy_from_data.to_json %>">
  <% if converser %>
    <div class="field">
      <div class="control">
        <label class="checkbox">
          <%# Stays ticked when a validation error re-renders the form. %>
          <%= check_box_tag :converser, "1", params[:converser] == "1",
                data: { questions_target: "converser", action: "questions#refresh" } %>
          Converser
        </label>
      </div>
    </div>
  <% end %>

  <div class="box" data-questions-target="section">
    <h2 class="subtitle">Questions</h2>

    <% if copy_from.any? %>
      <div class="field">
        <label class="label">Copy questions from</label>
        <div class="control">
          <div class="select">
            <%= select_tag :copy_from,
                  options_for_select([ [ "(Start blank)", "" ] ] + copy_from.map { |p| [ p.display_name, p.id ] }),
                  name: nil,
                  data: { questions_target: "copyFrom", action: "questions#copy" } %>
          </div>
        </div>
      </div>
    <% end %>

    <div data-questions-target="list">
      <%= render partial: "users/question_fields", collection: questions, as: :question %>
    </div>

    <div class="field">
      <div class="control">
        <button type="button" class="button is-link is-light" data-action="questions#add">Add question</button>
      </div>
    </div>
  </div>

  <template data-questions-target="template">
    <%= render "users/question_fields", question: nil %>
  </template>
</div>
